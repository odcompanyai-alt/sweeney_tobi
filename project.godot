; Engine configuration file.
; Godot 4.4+

config_version=5

[application]

config/name="Tobi Desktop Pet"
config/description="Tobias from Sweeney Todd, living on your desktop."
config/version="0.4.0"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
run/max_fps=60
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)
config/icon="res://icon.png"

[display]

window/size/viewport_width=240
window/size/viewport_height=250
window/size/resizable=false
window/size/borderless=true
window/size/always_on_top=true
window/size/transparent=true
window/size/initial_position_type=0
window/size/initial_position=Vector2i(0, 0)
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true
textures/vram_compression/import_etc2_astc=true
